 void SdlInputHandler::setWindow(SDL_Window *window)
 {
     m_Window = window;
+    m_LantoKeyboardFocused = (SDL_GetWindowFlags(window) & SDL_WINDOW_INPUT_FOCUS) != 0;
     pollLantoControl();
 }
 
 void SdlInputHandler::pollLantoControl()
 {
+    // A rejected keyup remains owed to the host even after focus/selection changes.
+    if (!m_LantoKeyRetryTimer.isValid() || m_LantoKeyRetryTimer.elapsed() >= 50) {
+        m_LantoKeyRetryTimer.restart();
+        retryLantoKeyReleases();
+        // Native focus can change before SDL observes the corresponding event.
+        if (m_LantoInput.managed() && m_LantoInput.locked() && !m_LantoInput.keyboardFocus())
+            raiseAllKeys();
+    }
     if (!m_LantoInput.managed() || !m_LantoInput.refresh() || !m_Window) return;
     m_PointerRegionLockActive = m_LantoInput.locked();
     m_PointerRegionLockToggledByUser = m_LantoInput.locked();
     m_CaptureSystemKeysMode = m_LantoInput.locked() ? StreamingPreferences::CSK_ALWAYS : StreamingPreferences::CSK_OFF;
     if (!m_LantoInput.remote()) {
@@ -287,10 +296,11 @@ void SdlInputHandler::pollLantoControl()
     }
 }
 
 void SdlInputHandler::notifyFocusLost()
 {
+    m_LantoKeyboardFocused = false;
     if (m_LantoInput.managed()) {
         setCaptureActive(false);
         for (int button = BUTTON_LEFT; button <= BUTTON_X2; button++)
             LiSendMouseButtonEvent(BUTTON_ACTION_RELEASE, button);
     }
@@ -308,10 +318,13 @@ void SdlInputHandler::notifyFocusLost()
