 void SdlInputHandler::notifyFocusGained()
 {
     if (m_LantoInput.managed()) {
+        // Clear any outstanding state before admitting this focus interval's presses.
+        raiseAllKeys();
+        m_LantoKeyboardFocused = true;
         m_LantoInput.refresh(true);
         m_LantoSwitchPending = false;
         setCaptureActive(true);
     }
 }
