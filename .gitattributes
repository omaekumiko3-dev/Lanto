* text=auto
*.md text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf
# Unified patches contain required single-space context lines.
*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof
.gitignore text eol=lf
.gitattributes text eol=lf
