[Unit]
Description=Lanto 4K virtual display for GNOME
After=graphical-session.target pipewire.service
PartOf=graphical-session.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
ExecStart=/usr/bin/python3 %h/.lanto/display/linux-virtual-display.py --virtual-only
Restart=on-failure
RestartSec=5
TimeoutStopSec=5

[Install]
WantedBy=graphical-session.target
