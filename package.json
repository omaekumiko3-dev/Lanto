{
  "name": "lanto",
  "productName": "Lanto",
  "version": "0.2.0",
  "description": "A personal LAN remote workspace.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "out/main/index.cjs",
  "author": "omaekumiko2-create",
  "repository": {
    "type": "git",
    "url": "https://github.com/omaekumiko2-create/Lanto.git"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "host": "node src/host/cli.ts",
    "host:build": "tsc -p tsconfig.host.json",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests scripts electron.vite.config.ts tsconfig*.json package.json .prettierrc.json",
    "format:check": "prettier --check src tests scripts electron.vite.config.ts tsconfig*.json package.json .prettierrc.json",
    "test": "node --test tests/*.test.ts",
    "test:smoke": "npm run build && node scripts/smoke.mjs",
    "build": "npm run typecheck && electron-vite build && npm run host:build && node scripts/build-deploy.mjs",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "bonjour-service": "1.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "selfsigned": "5.5.0",
    "ssh2": "1.17.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ssh2": "1.15.6",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.2",
    "electron-vite": "6.0.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
